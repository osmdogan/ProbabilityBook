        "#| fig-cap: Cutoff function $g_R(t)$ for $R=10$\n",
        "#| label: fig-cutoff-function\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "R = 10\n",
        "\n",
        "t = np.linspace(0, 1.2 * R, 1000)\n",
        "\n",
        "g_R = np.where(\n",
        "    t <= R / 2,\n",
        "    1,\n",
        "    np.where(\n",
        "        t <= R,\n",
        "        1 - (t - R / 2) / (R / 2),\n",
        "        0\n",
        "    )\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(5, 4))\n",
        "plt.plot(t, g_R, linewidth=2)\n",
        "plt.axvline(R / 2, linestyle=\"--\", alpha=0.6)\n",
        "plt.axvline(R, linestyle=\"--\", alpha=0.6)\n",
        "plt.xlabel(r\"$t$\")\n",
        "plt.ylabel(r\"$g_R(t)$\")\n",
        "plt.title(rf\"$g_R(t)$ with $R={R}$\")\n",
        "plt.ylim(-0.05, 1.1)\n",
        "plt.xlim(0, 1.2 * R)\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()"
      ],
