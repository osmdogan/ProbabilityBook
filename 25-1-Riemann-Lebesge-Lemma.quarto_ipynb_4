        "#| fig-cap: 'Sinc Function: Uniform Distribution Characteristic Function'\n",
        "x = np.linspace(-16 * np.pi, 16 * np.pi, 1000)\n",
        "y = np.sinc(x / np.pi)\n",
        "\n",
        "plt.figure(figsize=(5, 4))\n",
        "plt.plot(x, y, color='#1f77b4', linewidth=1.5)\n",
        "plt.axhline(0, color='black', linewidth=0.8, linestyle='--')\n",
        "plt.axvline(0, color='black', linewidth=0.8, linestyle='--')\n",
        "plt.title(r'Sinc Function: $\\hat{f}(\\xi) = \\frac{\\sin(\\xi)}{\\xi}$', fontsize=11)\n",
