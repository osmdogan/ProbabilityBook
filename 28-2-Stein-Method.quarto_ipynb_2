      "source": [
        "#| fig-cap: Normal tail probability and upper bound\n",
        "#| label: fig-normal-tail-bound\n",
        "# Define the range of t values\n",
        "t_values = np.linspace(0.01, 3, 100)\n",
        "\n",
        "# Compute the tail probability and the upper bound\n",
        "tail_prob = 1 - norm.cdf(t_values)\n",
        "upper_bound = np.minimum(0.5, np.exp(-t_values**2 / 2) / (np.sqrt(2 * np.pi) * t_values))\n",
        "\n",
        "# Plot the results\n",
        "plt.figure(figsize=(5, 4))\n",
        "plt.plot(t_values, tail_prob, label='$1 - \\\\Phi(t)$')\n",
        "plt.plot(t_values, upper_bound, label='$\\min\\{1/2, e^{-t^2/2}/(\\sqrt{2\\pi} t)\\}$')\n",
        "plt.xlabel('$t$')\n",
        "plt.ylabel('Probability')\n",
        "plt.legend(frameon=False)\n",
        "plt.show()"
      ],
