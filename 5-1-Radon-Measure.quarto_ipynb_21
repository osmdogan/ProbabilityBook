        "#| fig-cap: CDF of Uniform Distribution on [0, 1]\n",
        "#| label: fig-uniform-cdf\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = np.linspace(-0.5, 1.5, 500)\n",
        "\n",
        "F = np.piecewise(\n",
        "    x,\n",
        "    [x < 0, (x >= 0) & (x < 1), x >= 1],\n",
        "    [0, lambda x: x, 1]\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(4, 3))\n",
        "plt.plot(x, F)\n",
        "plt.xlabel(r'$x$')\n",
        "plt.ylabel(r'$F(x)$')\n",
        "#plt.title('CDF of Uniform Distribution on [0, 1]')\n",
        "plt.grid(True)\n",
        "plt.show()"
