        "#| fig-cap: CDF of Discrete Jump Measure\n",
        "#| label: fig-discrete-cdf\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Jump locations and CDF values\n",
        "x = np.array([-0.5, 0, 1, 2, 2.5])\n",
        "F = np.array([0, 1/3, 4/9, 1, 1])\n",
        "\n",
        "plt.figure(figsize=(5, 3.5))\n",
        "\n",
        "# Horizontal pieces\n",
        "plt.hlines(0, -0.5, 0, linewidth=1.5)\n",
        "plt.hlines(1/3, 0, 1, linewidth=1.5)\n",
        "plt.hlines(4/9, 1, 2, linewidth=1.5)\n",
        "plt.hlines(1, 2, 2.5, linewidth=1.5)\n",
        "\n",
        "# Vertical jumps\n",
        "plt.vlines(0, 0, 1/3, linewidth=1.5)\n",
        "plt.vlines(1, 1/3, 4/9, linewidth=1.5)\n",
        "plt.vlines(2, 4/9, 1, linewidth=1.5)\n",
        "\n",
        "# Filled circles: F(x), showing right-continuity\n",
        "plt.plot([0, 1, 2], [1/3, 4/9, 1], 'o')\n",
        "\n",
        "# Open circles: F(x-), showing failure of left-continuity\n",
        "plt.plot([0, 1, 2], [0, 1/3, 4/9], 'o',\n",
        "         markerfacecolor='white')\n",
        "\n",
        "plt.xlabel(r'$x$')\n",
        "plt.ylabel(r'$F(x)$')\n",
        "plt.grid(True)\n",
        "plt.show()"
